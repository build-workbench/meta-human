# Frontend API base URL
# Local development:
VITE_API_BASE_URL=http://localhost:8000

# Production example:
# VITE_API_BASE_URL=https://your-backend.example.com

# Comma-separated fallback endpoints (optional)
# VITE_API_BASE_URL_FALLBACKS=http://localhost:8001,http://backup:8000

# Chat transport mode: auto (default), http, or sse
# VITE_CHAT_TRANSPORT=auto
